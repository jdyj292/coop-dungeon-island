# 게임 서버 환경 변수 예시 (docs/deploy.md). 실제 값은 서버의 /etc/coop-dungeon-island.env 등에 두고 저장소에 넣지 않는다
NODE_ENV=production
# 게임 서버는 127.0.0.1에서만 듣고 Nginx가 넘긴다
SERVER_HOST=127.0.0.1
SERVER_PORT=2567
# SQLite 파일 (서비스 계정만 읽기·쓰기)
DB_PATH=/var/lib/coop-dungeon-island/game.sqlite
# 빌드한 클라이언트 (dist/public)
STATIC_DIR=/opt/coop-dungeon-island/public
# 우리 사이트 주소: WebSocket·/api의 Origin을 이것만 받음 (security.md 5장)
PUBLIC_ORIGIN=https://game.example.com
