# 매일 SQLite 온라인 백업, 7일치 보관 (security.md 6장, docs/deploy.md 6장). /etc/cron.d/coop-dungeon-island 로 둔다 (install.sh가 복사)
# cron.d 파일은 소유자 root, 권한 644, 마지막 줄 끝에 줄바꿈이 있어야 한다
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin
30 4 * * * coopgame cd /opt/coop-dungeon-island && set -a && . /etc/coop-dungeon-island.env && set +a && umask 077 && node admin.mjs backup --dir /var/lib/coop-dungeon-island/backups --keep 7 >> /var/lib/coop-dungeon-island/backup.log 2>&1
