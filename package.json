{
  "name": "coop-dungeon-island",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm --parallel --filter @game/client --filter @game/server dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p tools && tsc -p tools/run-sim && tsc -p tools/sprite-preview && tsc -p tools/motion-preview && tsc -p tools/sfx-preview",
    "palette-check": "tsx tools/palette-check/index.ts",
    "sprite-preview": "vite tools/sprite-preview",
    "motion-preview": "vite tools/motion-preview",
    "data-validate": "tsx tools/data-validate/index.ts",
    "sfx-preview": "vite tools/sfx-preview",
    "balance-check": "tsx tools/balance-check/index.ts",
    "ttk-sim": "tsx tools/ttk-sim/index.ts",
    "net-smoke": "tsx tools/net-smoke/index.ts",
    "map-gen": "tsx tools/map-gen/index.ts",
    "run-sim": "tsx --tsconfig tools/run-sim/tsconfig.json tools/run-sim/index.ts",
    "font-gen": "tsx tools/font-gen/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "colyseus.js": "^0.15.28",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
